# Copy this file to .env.local (already gitignored) and fill in real values.
# Restart `npm run dev` after changing it.

# The single shared password the organizing team uses to log into /admin.
ADMIN_PASSWORD=change-me

# Used to sign the admin login cookie. Any long random string — generate one
# with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-too

# Optional: override where the accommodation SQLite file lives. Defaults to
# ./data/accommodation.db, created automatically on first run.
# ACCOMMODATION_DB_PATH=./data/accommodation.db
